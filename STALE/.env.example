# OpenAI-compatible provider used for GPT-style generation and evaluation.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional separate provider for old-state generation.
QWEN_API_KEY=
QWEN_BASE_URL=

# Provider selectors used by Generation/IC_gen_config.py.
GPT_PROVIDER=OPENAI
QWEN_PROVIDER=QWEN
ASYNC_PROVIDER=OPENAI
EVAL_PROVIDER=OPENAI
JUDGE_PROVIDER=OPENAI

# Input/output paths.
IC_DATA_DIR=./data
NOISE_DATASET_DIR=./data/noise_sessions.json
ROOT_DATASET_DIR=./outputs

# Model names.
M_OLD_GEN_MODEL=qwen3.5-plus
M_NEW_GEN_MODEL=gpt-5.2
GEN_EVAL_MODEL=gpt-5.2
QA_ANS_GEN_MODEL=gemini-3.1-pro-preview
MODEL_FAST=gemini-3.1-flash-lite-preview
USER_SIDE_MODEL=gpt-5.2
ASSISTANT_SIDE_MODEL=gpt-5.1-chat-latest
TARGET_MODEL=gemini-3.1-flash-lite-preview
JUDGE_MODEL=gemini-3.1-flash-lite-preview

# Runtime controls.
TARGET_CONFLICTPAIR_AMOUNT_PER_SEED=1
MAX_ROUND_RESPONSE=10
MAX_ROUND_IN_SESSION=6
NOISE_SESSION_INSERT_CONCURRENCY_LIMIT=10
HAYSTACK_SESSION_AMOUNT=50
TASK_CONCURRENCY_LIMIT=5

# Timestamp scheduling and noise sampling safeguards.
MIN_MINUTES_AFTER_SNEW=60
STRICTLY_INCREASING_MINUTE=1
NOISE_SESSION_MAX_SAMPLE_ROUNDS=300
